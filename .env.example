# Copy to .env, or use the Docker secrets in ./secrets (preferred).
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# MASTER_KEY=
# ADMIN_PASSWORD=

# Ports on the host: HTTPS for the app, HTTP only redirects (and serves Let's Encrypt HTTP-01).
HTTPS_PORT=443
HTTP_PORT=80
# Extra hostnames/IPs in the self-signed certificate created on first start (comma separated)
# TLS_HOSTNAMES=drift.example.com,192.168.1.10
# Behind a reverse proxy that terminates TLS: TLS_ENABLED=false (app serves plain HTTP on 8080)
# TLS_ENABLED=true
SCAN_INTERVAL=900

# Image name and tag, e.g. IMAGE_NAME=git.example.com/team/talos-config-manager IMAGE_TAG=1.2.0
# IMAGE_NAME=talos-config-manager
# IMAGE_TAG=latest

# The image is always built for linux/amd64 and linux/arm64. The local image store must hold
# both: on Docker Desktop use its own builder (a docker-container builder only keeps one).
# BUILDX_BUILDER=desktop-linux

# talosctl version baked into the image: "latest" (default) or a tag like v1.11.5
# TALOSCTL_VERSION=latest

# Host directory mounted read-only on /configs (e.g. your home directory). In the UI you pick a
# base folder inside it to select files from; hidden files/folders are never shown or read.
# CONFIG_HOST_DIR=/Users/you

# --- Optional: login via Keycloak / OpenID Connect -------------------------------
# OIDC_ISSUER=https://sso.example.com/realms/infra
# OIDC_CLIENT_ID=talos-config-manager
# OIDC_CLIENT_SECRET=...            # or OIDC_CLIENT_SECRET_FILE=/run/secrets/oidc_client_secret
# OIDC_ALLOWED_ROLES=talos-config-manager    # realm or client roles, comma separated (recommended)
# OIDC_ALLOWED_GROUPS=              # groups claim, e.g. /platform/ops (needs a group mapper)
# OIDC_PROVIDER_NAME=Keycloak       # label on the login button
# OIDC_REDIRECT_URI=                # default: <app url>/auth/callback
# Without ADMIN_PASSWORD only OIDC login is possible.
# Who may change things (patches, settings, rollouts). Empty = everyone who may log in.
# OIDC_OPERATOR_ROLES=talos-operator
# OIDC_OPERATOR_GROUPS=

# --- Optional: notifications and metrics ------------------------------------------
# Webhooks (comma separated) for drift, unreachable nodes, unplanned differences and rollouts.
# NOTIFY_WEBHOOK_URLS=https://hooks.slack.com/services/...
# Prometheus metrics at /metrics with "Authorization: Bearer <token>" (off when empty).
# METRICS_TOKEN=
